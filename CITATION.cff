cff-version: 1.2.0

message: "If you use or refer to this repository, please cite it using the metadata below."

title: "Education, Social Origin and Occupational Status in China"

type: software

authors:
  - family-names: "Yang"
    given-names: "Minghao"

version: "1.1.0"

date-released: "2026-10-01"

repository-code: "https://github.com/minghaoyang-research/education-stratification-china"

abstract: >-
  R reproduction and post-submission audit of an undergraduate sociology
  dissertation using the 2017 China General Social Survey. Stages 01 to 04
  reconstruct and validate the submitted SPSS analysis. Stages 05 to 07
  examine ISEI crosswalk choices, sample coverage and selected model
  diagnostics while keeping the historical reproduction unchanged.

keywords:
  - sociology
  - social stratification
  - higher education
  - occupational status
  - CGSS
  - reproducibility
